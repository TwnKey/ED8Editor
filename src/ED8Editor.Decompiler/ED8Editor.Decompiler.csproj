<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Ce module encapsule le moteur natif valide (cs1_decompiler.dll). -->
    <!-- Warnings-as-errors relache ici (couche interop) le temps de stabiliser. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ED8Editor.Core\ED8Editor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le document (source de verite des instructions) est copie a cote de l'exe. -->
    <None Update="cs1_instructions.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <!-- Schema editable des records de tables (optionnel : retypage). -->
    <None Include="cs1_tables.json" Condition="Exists('cs1_tables.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- La DLL native, une fois construite via native\build.cmd, est copiee aussi. -->
    <None Include="native\cs1_decompiler.dll" Condition="Exists('native\cs1_decompiler.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>cs1_decompiler.dll</Link>
      <TargetPath>cs1_decompiler.dll</TargetPath>
    </None>
  </ItemGroup>

</Project>
